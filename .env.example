# Sahla — environment configuration.
# Copy this file to `.env` (which is git-ignored) and adjust values.
# Used by infra/docker-compose.yml and, for VITE_* vars, by the frontend.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=sahla
POSTGRES_USER=sahla
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend — Spring Boot REST API
# ---------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/sahla
SPRING_DATASOURCE_USERNAME=sahla
SPRING_DATASOURCE_PASSWORD=change-me
# Secret used to sign auth tokens (JWT). Generate a long random value.
JWT_SECRET=change-me

# ---------------------------------------------------------------------------
# Frontend — React + Vite
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
# Base URL of the backend REST API.
VITE_API_URL=http://localhost:8080/api
# When true, the frontend runs entirely on local mock data (no backend needed).
VITE_USE_MOCKS=true
