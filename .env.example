# Sahla — environment configuration.
# Copy this file to `.env` (which is git-ignored) and adjust values.
# Used by infra/docker-compose.yml and, for VITE_* vars, by the frontend.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=sahla
POSTGRES_USER=sahla
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend — Spring Boot REST API
# ---------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/sahla
SPRING_DATASOURCE_USERNAME=sahla
SPRING_DATASOURCE_PASSWORD=change-me
# Secret used to sign auth tokens (JWT). MUST be a long random value (>= 32
# chars). The app FAILS TO START if this is unset, shorter than 32 chars, or
# left as the literal "change-me". Generate one with, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me
# Access-token lifetime in ms. Falls back to this legacy value when
# JWT_ACCESS_EXPIRATION is unset (default 86400000 = 24h).
JWT_EXPIRATION=86400000
# Short-lived access token (default 900000 = 15 min) + longer refresh token
# (default 604800000 = 7 days). Clients call POST /api/auth/refresh to get a
# new access token, and POST /api/auth/logout to revoke the current one.
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Comma-separated list of browser origins allowed to call the API (CORS).
# Set this to your deployed frontend origin(s) in production.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend — React + Vite
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
# Base URL of the backend REST API.
VITE_API_URL=http://localhost:8080/api
# When true, the frontend runs entirely on local mock data (no backend needed).
VITE_USE_MOCKS=true
