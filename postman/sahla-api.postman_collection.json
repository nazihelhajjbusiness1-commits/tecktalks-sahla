    {
      "name": "Settlement (Sprint 4)",
      "description": "DT-78: Settlement Preview, Calculation and Confirmation for the Sprint 4 financial workflow. Depends on 'Login' ({{authToken}}/{{wrongRoleToken}}) and the Farmers folder ({{farmerId}}) having run. Creates its own dedicated product/grade/price so it never collides with price rules created elsewhere in the collection. Ledger, balance, payment and statement requests will be added once DT-70 to DT-73 are implemented.",
      "item": [
        {
          "name": "Setup: create settlement demo product -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Apple\",\n  \"variety\": \"Settlement-{{$timestamp}}\",\n  \"unit\": \"KG\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('settlementProductId', pm.response.json().id);"
            ] } }
          ]
        },
        {
          "name": "Setup: create settlement demo grade -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"gradeCode\": \"GRADE_A\",\n  \"name\": \"Grade A\",\n  \"description\": \"Premium\",\n  \"displayOrder\": 0,\n  \"active\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/products/{{settlementProductId}}/grades", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{settlementProductId}}", "grades"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('settlementGradeId', pm.response.json().id);"
            ] } }
          ]
        },
        {
          "name": "Setup: create settlement demo USD price ($1.20/kg) -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
